{
  "name": "tiker-cotizador",
  "private": true,
  "version": "1.1.0",
  "description": "Tiker - Sistema de Costos de Productos y Cotizador",
  "author": "Tiker",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.tiker.cotizador",
    "productName": "Tiker - Cotizador",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mashumadness",
        "repo": "ABM-y-Cotizador",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/favicon.ico",
      "public/logo-tiker.png"
    ],
    "portable": {
      "artifactName": "Tiker-Cotizador-Portable-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "artifactName": "Tiker-Cotizador-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tiker - Cotizador"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.1",
    "wait-on": "^9.5.1"
  }
}
